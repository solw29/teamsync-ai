FROM python:3.12-slim
RUN python -m pip install --no-cache-dir pytest==9.2.0 pydantic==2.14.3 httpx==0.28.1
WORKDIR /opt/teamsync
COPY --chown=65534:65534 --chmod=0555 teamsync /opt/teamsync/teamsync
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/teamsync PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
USER 65534:65534
ENTRYPOINT ["python", "-m", "teamsync.phase2_cli"]
